#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_REPO="${1:-$ROOT_DIR}"
SCAN_TREE=""

if (($# > 1)); then
  printf 'Usage: %s [git-repository]\n' "$0" >&2
  exit 2
fi

cleanup() {
  if [[ -n "$SCAN_TREE" ]]; then
    rm -rf -- "$SCAN_TREE"
  fi
}
trap cleanup EXIT

if ! git -C "$SOURCE_REPO" rev-parse --verify 'HEAD^{tree}' >/dev/null 2>&1; then
  echo "Error: a committed Git revision is required for secret scanning." >&2
  exit 1
fi

SCAN_TREE="$(mktemp -d)"

# Read tracked blobs directly from HEAD. git archive honors export-ignore and
# would silently omit tracked files that an attacker could exclude via
# .gitattributes. Materializing blobs as regular files also avoids following
# symlinks from the checkout.
git -C "$SOURCE_REPO" ls-tree -r -z --name-only HEAD |
  while IFS= read -r -d '' path; do
    case "$path" in
    /* | .. | ../* | */.. | */../* | .)
      echo "Error: unsafe tracked path encountered during secret scanning." >&2
      exit 1
      ;;
    esac

    destination="$SCAN_TREE/$path"
    mkdir -p -- "$(dirname -- "$destination")"
    git -C "$SOURCE_REPO" cat-file blob "HEAD:$path" >"$destination"
  done

gitleaks dir --config "$ROOT_DIR/.gitleaks.toml" --no-banner --no-color --redact=100 --exit-code 1 "$SCAN_TREE"
