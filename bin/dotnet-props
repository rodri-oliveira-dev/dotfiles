#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=lib/dotnet-common.sh
DOTNET_PROPS_SOURCE="$DOTNET_HELPER_PATH"
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

usage() {
  cat <<'USAGE'
Usage: dotnet-props [--json] [target]

Show a standard snapshot of evaluated MSBuild properties for a .NET project
without running a build.

Options:
  --json  Emit the MSBuild JSON response in a single evaluation.
  --help  Show this help message.

Target:
  Optional .csproj, .fsproj, or .vbproj path. When omitted, the helper discovers
  project files in the current Git repository. Exactly one project is selected
  automatically; multiple projects require an explicit target.
USAGE
}

OUTPUT_JSON=false
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --json)
    OUTPUT_JSON=true
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    if (($# > 1)); then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    if (($# == 1)); then
      if [[ -n "$EXPLICIT_TARGET" ]]; then
        echo "Error: only one target may be specified." >&2
        usage >&2
        exit 2
      fi
      EXPLICIT_TARGET="$1"
    fi
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$EXPLICIT_TARGET" ]]; then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="$1"
    ;;
  esac
  shift
done

dotnet_common_require_host 2
ROOT="$(dotnet_common_root)"
dotnet_common_resolve_sdk "$ROOT" "no .NET SDK could be resolved for $ROOT."
dotnet_common_require_msbuild_sdk
dotnet_common_find_projects "$ROOT"
dotnet_common_select_project_target "$ROOT" "$EXPLICIT_TARGET" "dotnet-props"

PROPERTIES=(
  TargetFramework
  TargetFrameworks
  Configuration
  Platform
  RuntimeIdentifier
  RuntimeIdentifiers
  LangVersion
  Nullable
  ImplicitUsings
  TreatWarningsAsErrors
  WarningsAsErrors
  NoWarn
  ManagePackageVersionsCentrally
  CentralPackageTransitivePinningEnabled
  RestorePackagesWithLockFile
  ContinuousIntegrationBuild
  Deterministic
  GenerateDocumentationFile
  OutputPath
)

IFS=,
PROPERTY_LIST="${PROPERTIES[*]}"
unset IFS

if [[ "$OUTPUT_JSON" == "true" ]]; then
  # The JSON CLI contract remains the unmodified output and exit status of MSBuild.
  (cd "$ROOT" && dotnet msbuild "$TARGET" "-getProperty:$PROPERTY_LIST" -nologo)
  exit $?
fi

# Only the human-readable mode needs Python's standard-library JSON parser.
# Check before evaluating MSBuild so a missing dependency cannot execute the
# project and then fail to render the result.
if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: Python 3 is required to format dotnet-props output; use --json to obtain the MSBuild response without Python." >&2
  exit 2
fi

if ! SNAPSHOT="$(cd "$ROOT" && dotnet msbuild "$TARGET" "-getProperty:$PROPERTY_LIST" -nologo)"; then
  echo "Error: failed to evaluate MSBuild properties." >&2
  exit 1
fi

# Validate all 19 property values before emitting any part of the human report.
# A JSON parsing error must not create an apparently complete partial snapshot.
if ! printf '%s\n' "$SNAPSHOT" | python3 "$(cd -- "$(dirname -- "$DOTNET_PROPS_SOURCE")/../lib" && pwd)/dotnet-props-format.py" "${TARGET#"$ROOT"/}" "${PROPERTIES[@]}"; then
  echo "Error: failed to format evaluated MSBuild properties." >&2
  exit 1
fi
