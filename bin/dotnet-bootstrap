#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=../lib/dotnet-common.sh
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

echo "Bootstrapping .NET repository..."
echo

dotnet_common_require_host 1

ROOT="$(dotnet_common_root)"

if [[ -f "$ROOT/global.json" ]]; then
  if ! SDK_VERSION="$(cd "$ROOT" && dotnet --version)"; then
    echo "Error: no compatible .NET SDK could be resolved for $ROOT/global.json." >&2
    exit 1
  fi

  echo "Resolved SDK:"
  printf '%s\n' "$SDK_VERSION"
  echo
fi

if [[ -f "$ROOT/.config/dotnet-tools.json" ]]; then
  echo "Restoring local .NET tools..."
  (cd "$ROOT" && dotnet tool restore)
  echo
fi

dotnet_common_find_solutions "$ROOT"

print_solution_choices() {
  dotnet_common_print_solution_choices "$ROOT" "dotnet-bootstrap"
}

echo "Restoring NuGet packages..."

if (($# == 0)); then
  case "${#SOLUTIONS[@]}" in
  0)
    (cd "$ROOT" && dotnet restore)
    ;;
  1)
    dotnet restore "${SOLUTIONS[0]}"
    ;;
  *)
    print_solution_choices
    exit 2
    ;;
  esac
elif [[ "$1" == -* ]]; then
  case "${#SOLUTIONS[@]}" in
  0)
    (cd "$ROOT" && dotnet restore "$@")
    ;;
  1)
    dotnet restore "${SOLUTIONS[0]}" "$@"
    ;;
  *)
    print_solution_choices
    exit 2
    ;;
  esac
else
  EXPLICIT_TARGET="$1"
  shift

  if [[ "$EXPLICIT_TARGET" != /* && -e "$ROOT/$EXPLICIT_TARGET" ]]; then
    EXPLICIT_TARGET="$ROOT/$EXPLICIT_TARGET"
  fi

  dotnet restore "$EXPLICIT_TARGET" "$@"
fi

echo
echo "Repository ready."
