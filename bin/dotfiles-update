#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"

if [[ -L "$SCRIPT_PATH" ]]; then
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"

  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET"
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v git >/dev/null 2>&1; then
  echo "Error: git is required to update dotfiles." >&2
  exit 1
fi

if ! git -C "$DOTFILES_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: $DOTFILES_DIR is not a Git worktree." >&2
  exit 1
fi

if [[ -n "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
  echo "Error: dotfiles contains uncommitted changes. Commit or stash them before updating." >&2
  exit 1
fi

if ! git -C "$DOTFILES_DIR" symbolic-ref --quiet HEAD >/dev/null 2>&1; then
  echo "Error: dotfiles is in detached HEAD state. Switch to a branch before updating." >&2
  exit 1
fi

if ! git -C "$DOTFILES_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  echo "Error: the current dotfiles branch has no upstream configured." >&2
  exit 1
fi

echo "Fetching dotfiles updates..."
git -C "$DOTFILES_DIR" fetch --prune

echo "Applying fast-forward updates only..."
git -C "$DOTFILES_DIR" pull --ff-only

echo "Refreshing managed configuration..."
"$DOTFILES_DIR/install.sh"

echo "Running environment diagnostics..."
"$DOTFILES_DIR/bin/dotfiles-doctor"

echo
echo "Dotfiles updated successfully."
