#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: dotnet-items <item> [target]

Show evaluated MSBuild items and their metadata for a .NET project without
running a build. MSBuild emits item results as JSON.

Target:
  Optional .csproj, .fsproj, or .vbproj path. When omitted, the helper discovers
  project files in the current Git repository. Exactly one project is selected
  automatically; multiple projects require an explicit target.
USAGE
}

ITEM=""
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    while (($# > 0)); do
      if [[ -z "$ITEM" ]]; then
        ITEM="$1"
      elif [[ -z "$EXPLICIT_TARGET" ]]; then
        EXPLICIT_TARGET="$1"
      else
        echo "Error: only one item expression and one target may be specified." >&2
        usage >&2
        exit 2
      fi
      shift
    done
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -z "$ITEM" ]]; then
      ITEM="$1"
    elif [[ -z "$EXPLICIT_TARGET" ]]; then
      EXPLICIT_TARGET="$1"
    else
      echo "Error: only one item expression and one target may be specified." >&2
      usage >&2
      exit 2
    fi
    ;;
  esac
  shift
done

if [[ -z "$ITEM" ]]; then
  echo "Error: an MSBuild item name is required." >&2
  usage >&2
  exit 2
fi

if ! command -v dotnet >/dev/null 2>&1; then
  echo "Error: .NET SDK is not available in PATH." >&2
  exit 2
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if ! SDK_VERSION="$(cd "$ROOT" && dotnet --version 2>/dev/null)"; then
  if [[ -f "$ROOT/global.json" ]]; then
    echo "Error: no compatible .NET SDK could be resolved for $ROOT/global.json." >&2
  else
    echo "Error: no .NET SDK could be resolved for $ROOT." >&2
  fi
  exit 2
fi

SDK_CORE="${SDK_VERSION%%-*}"
IFS=. read -r SDK_MAJOR _ <<<"$SDK_CORE"
if ! [[ "$SDK_MAJOR" =~ ^[0-9]+$ ]] || ((SDK_MAJOR < 8)); then
  printf 'Error: MSBuild evaluation helpers require .NET SDK 8 or later; resolved %s.\n' "$SDK_VERSION" >&2
  exit 2
fi

mapfile -t PROJECTS < <(
  find "$ROOT" \
    \( -type d \( \
    -name .git -o \
    -name bin -o \
    -name obj -o \
    -name node_modules -o \
    -name artifacts -o \
    -name .artifacts \
    \) -prune \) -o \
    \( -type f \( \
    -name '*.csproj' -o \
    -name '*.fsproj' -o \
    -name '*.vbproj' \
    \) -print \) | sort
)

print_project_choices() {
  echo "Multiple project files were found in the repository:" >&2

  local project
  for project in "${PROJECTS[@]}"; do
    printf '  - %s\n' "${project#"$ROOT"/}" >&2
  done

  echo >&2
  echo "Specify the project explicitly, for example:" >&2
  printf '  dotnet-items %s %s\n' "$ITEM" "${PROJECTS[0]#"$ROOT"/}" >&2
}

TARGET=""
if [[ -n "$EXPLICIT_TARGET" ]]; then
  if [[ "$EXPLICIT_TARGET" == /* ]]; then
    TARGET="$EXPLICIT_TARGET"
  else
    TARGET="$ROOT/$EXPLICIT_TARGET"
  fi

  if [[ ! -f "$TARGET" ]]; then
    printf 'Error: target does not exist: %s\n' "$EXPLICIT_TARGET" >&2
    exit 2
  fi

  case "$TARGET" in
  *.csproj | *.fsproj | *.vbproj) ;;
  *)
    printf 'Error: target must be a .csproj, .fsproj, or .vbproj file: %s\n' "$EXPLICIT_TARGET" >&2
    exit 2
    ;;
  esac
else
  case "${#PROJECTS[@]}" in
  0)
    echo "Error: no .NET project files were found in the repository." >&2
    exit 2
    ;;
  1)
    TARGET="${PROJECTS[0]}"
    ;;
  *)
    print_project_choices
    exit 2
    ;;
  esac
fi

(cd "$ROOT" && dotnet msbuild "$TARGET" "-getItem:$ITEM" -nologo)
