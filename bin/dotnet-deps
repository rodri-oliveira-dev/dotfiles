#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: dotnet-deps <vulnerable|outdated|deprecated> [options] [target]

Inspect NuGet dependency health for the current .NET repository.

Options:
  --include-transitive  Include transitive package references.
  --json                Emit the .NET CLI JSON report (SDK 7.0.200+).
  --help                Show this help message.

Target:
  Optional project or solution path. When omitted, a single root-level .sln or
  .slnx is selected automatically. Multiple root-level solutions require an
  explicit target.
USAGE
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

MODE="$1"
shift

case "$MODE" in
vulnerable | outdated | deprecated) ;;
--help | -h)
  usage
  exit 0
  ;;
*)
  printf 'Error: unsupported dependency diagnostic: %s\n' "$MODE" >&2
  usage >&2
  exit 2
  ;;
esac

INCLUDE_TRANSITIVE=false
OUTPUT_JSON=false
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --include-transitive)
    INCLUDE_TRANSITIVE=true
    ;;
  --json)
    OUTPUT_JSON=true
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    if (($# > 1)); then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="${1:-}"
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$EXPLICIT_TARGET" ]]; then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="$1"
    ;;
  esac
  shift
done

if ! command -v dotnet >/dev/null 2>&1; then
  echo "Error: .NET SDK is not available in PATH." >&2
  exit 2
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if ! SDK_VERSION="$(cd "$ROOT" && dotnet --version 2>/dev/null)"; then
  if [[ -f "$ROOT/global.json" ]]; then
    echo "Error: no compatible .NET SDK could be resolved for $ROOT/global.json." >&2
  else
    echo "Error: no .NET SDK could be resolved for $ROOT." >&2
  fi
  exit 2
fi

SDK_CORE="${SDK_VERSION%%-*}"
IFS=. read -r SDK_MAJOR SDK_MINOR SDK_PATCH _ <<<"$SDK_CORE"

if ! [[ "$SDK_MAJOR" =~ ^[0-9]+$ && "$SDK_MINOR" =~ ^[0-9]+$ && "$SDK_PATCH" =~ ^[0-9]+$ ]]; then
  printf 'Error: unable to interpret resolved .NET SDK version: %s\n' "$SDK_VERSION" >&2
  exit 2
fi

if [[ "$OUTPUT_JSON" == "true" ]]; then
  if ((SDK_MAJOR < 7 || (SDK_MAJOR == 7 && SDK_MINOR == 0 && SDK_PATCH < 200))); then
    printf 'Error: --json requires .NET SDK 7.0.200 or later; resolved %s.\n' "$SDK_VERSION" >&2
    exit 2
  fi
fi

shopt -s nullglob
SOLUTIONS=("$ROOT"/*.sln "$ROOT"/*.slnx)
shopt -u nullglob

print_solution_choices() {
  echo "Multiple solution files were found in the repository root:" >&2

  local solution
  for solution in "${SOLUTIONS[@]}"; do
    printf '  - %s\n' "${solution#"$ROOT"/}" >&2
  done

  echo >&2
  echo "Specify the target explicitly, for example:" >&2
  printf '  dotnet-deps %s %s\n' "$MODE" "${SOLUTIONS[0]#"$ROOT"/}" >&2
}

TARGET=""
if [[ -n "$EXPLICIT_TARGET" ]]; then
  if [[ "$EXPLICIT_TARGET" == /* ]]; then
    TARGET="$EXPLICIT_TARGET"
  else
    TARGET="$ROOT/$EXPLICIT_TARGET"
  fi

  if [[ ! -e "$TARGET" ]]; then
    printf 'Error: target does not exist: %s\n' "$EXPLICIT_TARGET" >&2
    exit 2
  fi
else
  case "${#SOLUTIONS[@]}" in
  0) ;;
  1)
    TARGET="${SOLUTIONS[0]}"
    ;;
  *)
    print_solution_choices
    exit 2
    ;;
  esac
fi

COMMAND=()
if ((SDK_MAJOR >= 10)); then
  COMMAND=(package list)
  if [[ -n "$TARGET" ]]; then
    COMMAND+=(--project "$TARGET")
  fi
else
  COMMAND=(list)
  if [[ -n "$TARGET" ]]; then
    COMMAND+=("$TARGET")
  fi
  COMMAND+=(package)
fi

COMMAND+=("--$MODE")

if [[ "$INCLUDE_TRANSITIVE" == "true" ]]; then
  COMMAND+=(--include-transitive)
fi

if [[ "$OUTPUT_JSON" == "true" ]]; then
  COMMAND+=(--format json --output-version 1)
fi

(cd "$ROOT" && dotnet "${COMMAND[@]}")
