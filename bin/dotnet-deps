#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=lib/dotnet-common.sh
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

usage() {
  cat <<'USAGE'
Usage: dotnet-deps <vulnerable|outdated|deprecated> [options] [target]

Inspect NuGet dependency health for the current .NET repository.

Options:
  --include-transitive  Include transitive package references.
  --json                Emit the .NET CLI JSON report (SDK 7.0.200+).
  --help                Show this help message.

Target:
  Optional project or solution path. When omitted, a single root-level .sln or
  .slnx is selected automatically. Multiple root-level solutions require an
  explicit target.
USAGE
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

MODE="$1"
shift

case "$MODE" in
vulnerable | outdated | deprecated) ;;
--help | -h)
  usage
  exit 0
  ;;
*)
  printf 'Error: unsupported dependency diagnostic: %s\n' "$MODE" >&2
  usage >&2
  exit 2
  ;;
esac

INCLUDE_TRANSITIVE=false
OUTPUT_JSON=false
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --include-transitive)
    INCLUDE_TRANSITIVE=true
    ;;
  --json)
    OUTPUT_JSON=true
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    if (($# > 1)); then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="${1:-}"
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$EXPLICIT_TARGET" ]]; then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="$1"
    ;;
  esac
  shift
done

dotnet_common_require_host 2
ROOT="$(dotnet_common_root)"
dotnet_common_resolve_sdk "$ROOT" "no .NET SDK could be resolved for $ROOT."
dotnet_common_parse_sdk_triplet

if [[ "$OUTPUT_JSON" == "true" ]]; then
  if ((SDK_MAJOR < 7 || (SDK_MAJOR == 7 && SDK_MINOR == 0 && SDK_PATCH < 200))); then
    printf 'Error: --json requires .NET SDK 7.0.200 or later; resolved %s.\n' "$SDK_VERSION" >&2
    exit 2
  fi
fi

dotnet_common_find_solutions "$ROOT"
dotnet_common_select_solution_target "$ROOT" "$EXPLICIT_TARGET" "dotnet-deps $MODE"

COMMAND=()
if ((SDK_MAJOR >= 10)); then
  COMMAND=(package list)
  if [[ -n "$TARGET" ]]; then
    COMMAND+=(--project "$TARGET")
  fi
else
  COMMAND=(list)
  if [[ -n "$TARGET" ]]; then
    COMMAND+=("$TARGET")
  fi
  COMMAND+=(package)
fi

COMMAND+=("--$MODE")

if [[ "$INCLUDE_TRANSITIVE" == "true" ]]; then
  COMMAND+=(--include-transitive)
fi

if [[ "$OUTPUT_JSON" == "true" ]]; then
  COMMAND+=(--format json --output-version 1)
fi

(cd "$ROOT" && dotnet "${COMMAND[@]}")
