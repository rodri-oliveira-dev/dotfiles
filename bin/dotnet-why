#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=../lib/dotnet-common.sh
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

usage() {
  cat <<'USAGE'
Usage: dotnet-why [--framework <framework>] <package> [target]

Show why a NuGet package is present in the current .NET repository.

Options:
  -f, --framework <framework>  Restrict the dependency graph to one framework.
  --help                       Show this help message.

Target:
  Optional project or solution path. When omitted, a single root-level .sln or
  .slnx is selected automatically. If no root solution exists, a single project
  in the repository is selected. Ambiguous repositories require an explicit
  target.
USAGE
}

PACKAGE=""
FRAMEWORK=""
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  -f | --framework)
    if (($# < 2)) || [[ -z "$2" ]]; then
      echo "Error: --framework requires a value." >&2
      usage >&2
      exit 2
    fi
    FRAMEWORK="$2"
    shift
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    while (($# > 0)); do
      if [[ -z "$PACKAGE" ]]; then
        PACKAGE="$1"
      elif [[ -z "$EXPLICIT_TARGET" ]]; then
        EXPLICIT_TARGET="$1"
      else
        echo "Error: only one package and one target may be specified." >&2
        usage >&2
        exit 2
      fi
      shift
    done
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -z "$PACKAGE" ]]; then
      PACKAGE="$1"
    elif [[ -z "$EXPLICIT_TARGET" ]]; then
      EXPLICIT_TARGET="$1"
    else
      echo "Error: only one package and one target may be specified." >&2
      usage >&2
      exit 2
    fi
    ;;
  esac
  shift
done

if [[ -z "$PACKAGE" ]]; then
  echo "Error: a package ID is required." >&2
  usage >&2
  exit 2
fi

dotnet_common_require_host
ROOT="$(dotnet_common_root)"
dotnet_common_resolve_sdk "$ROOT" "no .NET SDK could be resolved for $ROOT."
dotnet_common_parse_sdk_triplet

if ((SDK_MAJOR < 8 || (SDK_MAJOR == 8 && SDK_MINOR == 0 && SDK_PATCH < 400))); then
  printf 'Error: dotnet nuget why requires .NET SDK 8.0.400 or later; resolved %s.\n' "$SDK_VERSION" >&2
  exit 2
fi

dotnet_common_find_solutions "$ROOT"
dotnet_common_find_projects "$ROOT"

TARGET=""
if [[ -n "$EXPLICIT_TARGET" ]]; then
  dotnet_common_resolve_explicit_target "$ROOT" "$EXPLICIT_TARGET"
else
  case "${#SOLUTIONS[@]}" in
  0)
    case "${#PROJECTS[@]}" in
    0) TARGET="$ROOT" ;;
    1) TARGET="${PROJECTS[0]}" ;;
    *)
      dotnet_common_print_project_choices "$ROOT" "dotnet-why $PACKAGE" "No root-level solution was found and multiple project files exist:"
      exit 2
      ;;
    esac
    ;;
  1) TARGET="${SOLUTIONS[0]}" ;;
  *)
    dotnet_common_print_solution_choices "$ROOT" "dotnet-why $PACKAGE"
    exit 2
    ;;
  esac
fi

COMMAND=(nuget why "$TARGET" "$PACKAGE")

if [[ -n "$FRAMEWORK" ]]; then
  COMMAND+=(--framework "$FRAMEWORK")
fi

(cd "$ROOT" && dotnet "${COMMAND[@]}")
