#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "Repository"
echo "----------"
printf '%s\n' "$ROOT"

echo
echo ".NET"
echo "----"

if command -v dotnet >/dev/null 2>&1; then
  if SDK_VERSION="$(cd "$ROOT" && dotnet --version 2>/dev/null)"; then
    printf 'SDK: %s\n' "$SDK_VERSION"
  else
    echo "SDK: installed, but no compatible SDK could be resolved for this repository"
  fi
else
  echo ".NET SDK not found"
fi

if [[ -f "$ROOT/global.json" ]]; then
  echo "global.json: yes"
else
  echo "global.json: no"
fi

if [[ -f "$ROOT/Directory.Build.props" ]]; then
  echo "Directory.Build.props: yes"
else
  echo "Directory.Build.props: no"
fi

if [[ -f "$ROOT/Directory.Packages.props" ]]; then
  echo "Central Package Management: yes"
else
  echo "Central Package Management: no"
fi

if [[ -f "$ROOT/.config/dotnet-tools.json" ]]; then
  echo "Local tool manifest: yes"
else
  echo "Local tool manifest: no"
fi

echo
echo "Solutions"
echo "---------"

shopt -s nullglob
SOLUTIONS=("$ROOT"/*.sln "$ROOT"/*.slnx)
shopt -u nullglob

if (("${#SOLUTIONS[@]}" == 0)); then
  echo "(none)"
else
  for solution in "${SOLUTIONS[@]}"; do
    printf '%s\n' "${solution#"$ROOT"/}"
  done
fi
