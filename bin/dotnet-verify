#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=lib/dotnet-common.sh
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

usage() {
  cat <<'USAGE'
Usage: dotnet-verify [options] [target]

Run a local .NET repository preflight without changing project configuration.

Options:
  --quick      Restore and build only.
  --full       Restore, build, verify formatting, and run tests (default).
  --no-format  Skip dotnet format verification.
  --no-test    Skip dotnet test.
  --help       Show this help message.

Target:
  Optional project or solution path. When omitted, a single root-level .sln or
  .slnx is selected automatically. Multiple root-level solutions require an
  explicit target.
USAGE
}

RUN_FORMAT=true
RUN_TESTS=true
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --quick)
    RUN_FORMAT=false
    RUN_TESTS=false
    ;;
  --full)
    RUN_FORMAT=true
    RUN_TESTS=true
    ;;
  --no-format)
    RUN_FORMAT=false
    ;;
  --no-test)
    RUN_TESTS=false
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    if (($# > 1)); then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="${1:-}"
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$EXPLICIT_TARGET" ]]; then
      echo "Error: only one target may be specified." >&2
      usage >&2
      exit 2
    fi
    EXPLICIT_TARGET="$1"
    ;;
  esac
  shift
done

dotnet_common_require_host
ROOT="$(dotnet_common_root)"
dotnet_common_resolve_sdk "$ROOT" "no .NET SDK could be resolved. The dotnet host is available, but an SDK is required."

if [[ -f "$ROOT/global.json" ]]; then
  printf 'Resolved SDK: %s\n\n' "$SDK_VERSION"
fi

dotnet_common_find_solutions "$ROOT"
dotnet_common_select_solution_target "$ROOT" "$EXPLICIT_TARGET" "dotnet-verify"

TARGET_ARGS=()
if [[ -n "$TARGET" ]]; then
  TARGET_ARGS+=("$TARGET")
fi

run_dotnet_step() {
  local description="$1"
  shift

  printf '%s...\n' "$description"
  if ! (cd "$ROOT" && dotnet "$@"); then
    printf 'Error: %s failed.\n' "$description" >&2
    exit 1
  fi
}

printf 'Verifying .NET repository: %s\n\n' "$ROOT"

if [[ -f "$ROOT/.config/dotnet-tools.json" ]]; then
  run_dotnet_step "Restoring local .NET tools" tool restore
fi

run_dotnet_step "Restoring packages" restore "${TARGET_ARGS[@]}"
run_dotnet_step "Building repository" build "${TARGET_ARGS[@]}" --no-restore

if [[ "$RUN_FORMAT" == "true" ]]; then
  run_dotnet_step "Verifying formatting" format "${TARGET_ARGS[@]}" --verify-no-changes --no-restore
fi

if [[ "$RUN_TESTS" == "true" ]]; then
  run_dotnet_step "Running tests" test "${TARGET_ARGS[@]}" --no-build --no-restore
fi

printf '\nRepository verification completed successfully.\n'
