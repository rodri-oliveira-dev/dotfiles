#!/usr/bin/env bash
set -euo pipefail

DOTNET_HELPER_PATH="${BASH_SOURCE[0]}"
DOTNET_HELPER_HOPS=0
while [[ -L "$DOTNET_HELPER_PATH" ]]; do
  ((DOTNET_HELPER_HOPS += 1))
  if ((DOTNET_HELPER_HOPS > 16)); then
    echo "Error: too many dotfiles helper symlinks." >&2
    exit 2
  fi
  DOTNET_HELPER_LINK="$(readlink -- "$DOTNET_HELPER_PATH")"
  if [[ "$DOTNET_HELPER_LINK" == /* ]]; then
    DOTNET_HELPER_PATH="$DOTNET_HELPER_LINK"
  else
    DOTNET_HELPER_PATH="$(dirname -- "$DOTNET_HELPER_PATH")/$DOTNET_HELPER_LINK"
  fi
done
# shellcheck source=lib/dotnet-common.sh
source "$(cd -- "$(dirname -- "$DOTNET_HELPER_PATH")/../lib" && pwd)/dotnet-common.sh"
unset DOTNET_HELPER_PATH DOTNET_HELPER_HOPS DOTNET_HELPER_LINK

usage() {
  cat <<'USAGE'
Usage: dotnet-prop <property> [target]

Show one evaluated MSBuild property for a .NET project without running a build.

Target:
  Optional .csproj, .fsproj, or .vbproj path. When omitted, the helper discovers
  project files in the current Git repository. Exactly one project is selected
  automatically; multiple projects require an explicit target.
USAGE
}

PROPERTY=""
EXPLICIT_TARGET=""

while (($# > 0)); do
  case "$1" in
  --help | -h)
    usage
    exit 0
    ;;
  --)
    shift
    while (($# > 0)); do
      if [[ -z "$PROPERTY" ]]; then
        PROPERTY="$1"
      elif [[ -z "$EXPLICIT_TARGET" ]]; then
        EXPLICIT_TARGET="$1"
      else
        echo "Error: only one property and one target may be specified." >&2
        usage >&2
        exit 2
      fi
      shift
    done
    break
    ;;
  -*)
    printf 'Error: unsupported argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -z "$PROPERTY" ]]; then
      PROPERTY="$1"
    elif [[ -z "$EXPLICIT_TARGET" ]]; then
      EXPLICIT_TARGET="$1"
    else
      echo "Error: only one property and one target may be specified." >&2
      usage >&2
      exit 2
    fi
    ;;
  esac
  shift
done

if [[ -z "$PROPERTY" ]]; then
  echo "Error: an MSBuild property name is required." >&2
  usage >&2
  exit 2
fi

if [[ "$PROPERTY" == *,* ]]; then
  echo "Error: dotnet-prop accepts exactly one property; use dotnet-props for the standard snapshot." >&2
  exit 2
fi

dotnet_common_require_host
ROOT="$(dotnet_common_root)"
dotnet_common_resolve_sdk "$ROOT" "no .NET SDK could be resolved for $ROOT."
dotnet_common_require_msbuild_sdk
dotnet_common_find_projects "$ROOT"
dotnet_common_select_project_target "$ROOT" "$EXPLICIT_TARGET" "dotnet-prop $PROPERTY"

(cd "$ROOT" && dotnet msbuild "$TARGET" "-getProperty:$PROPERTY" -nologo)
